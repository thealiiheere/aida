# Copy to .env. Every value is optional; blank means "use the default".

STORE_NAME=Aida Demo Store
# The language of the admin's Telegram messages, the store console and the checkout
# page: en, uz or ru. Customers get theirs in the language they last wrote to the bot
# in. The console and checkout page can also be switched by whoever is looking.
STORE_LANGUAGE=en

# Telegram, for admin notifications and the chat. Leave blank to run in dry-run mode:
# messages are logged and returned by the API, but nothing is sent.
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
# Used to tag the admin on escalations. Needed if ADMIN_CHAT_ID is a group.
ADMIN_USERNAME=
# What Aida calls the admin: "I've passed your order notes to ...".
ADMIN_NAME=our store manager

# Shared secret the operator sends as the X-API-Key header.
# Blank leaves the API open, which is only OK on localhost.
AGENT_API_KEY=

# Payment links are PAYMENT_BASE_URL/{invoice_id}. The built-in mock checkout
# lives at /pay, so customers on a phone need a public URL here.
PAYMENT_BASE_URL=http://localhost:8000/pay

# Default is aida.db in the project folder.
DATABASE_URL=

# Which AI thinks up Aida's answers, in the chat, on calls and in call summaries:
# anthropic (Claude), openai or gemini.
LLM_PROVIDER=anthropic

# Claude, if LLM_PROVIDER is anthropic.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5-5

# --- Real payments ---

# Setting either gateway's key turns the demo checkout page off.
# Prices are in dollars; Click and Payme charge soum.
UZS_PER_USD=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme sends this login and key with every request. The login isn't in the public
# documentation, so check yours with Payme.
PAYME_LOGIN=Paycom
PAYME_KEY=

# --- Chat and phone calls ---

# Where the store backend runs.
BACKEND_URL=http://localhost:8000

# claude-haiku-5-5 is faster and cheaper. Fast mode is about twice the price.
AIDA_MODEL=claude-opus-5-5
AIDA_EFFORT=low
AIDA_FAST_MODE=false

# OpenAI, if LLM_PROVIDER is openai. Make the key at platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# For reasoning models (gpt-5 and o-series): minimal, low, medium or high. Leave empty
# for models that don't reason, such as gpt-4.1.
OPENAI_REASONING_EFFORT=low

# Gemini, if LLM_PROVIDER is gemini, and for calls if VOICE_ENGINE is gemini_live.
# Make the key at aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The chat's fixed lines, such as the apology when Claude can't answer: en, uz or ru,
# until the customer writes in another of the three. The greeting on Start follows
# their Telegram app's language. Aida's own answers always follow the customer.
CHAT_LANGUAGE=en

# Where the chat keeps its conversations. Default is chat.db in the project folder.
CHAT_DATABASE=

# --- Phone calls (voice/) ---

# Public HTTPS address of the phone line, without a trailing path.
VOICE_PUBLIC_URL=
# From the Twilio console. Proves that a request really comes from Twilio.
TWILIO_AUTH_TOKEN=
# Live transfers go here, for example +998901234567. Blank means the admin is
# only messaged on Telegram, and Aida tells the caller they'll be contacted.
ADMIN_PHONE=

# What runs a call. pipeline: speech to text, the AI above and text to speech, from
# the providers below. gemini_live: Gemini Live hears, thinks and speaks by itself,
# with only GEMINI_API_KEY; the STT, TTS and AI settings are then unused on calls.
VOICE_ENGINE=pipeline
GEMINI_LIVE_MODEL=gemini-3.8-live
# Gemini's voice: Kore, Aoede, Leda, Puck, Charon, Fenrir and others.
GEMINI_VOICE=Kore

# What Aida speaks first on the phone: en, uz (Uzbek, needs VoiceLab) or ru. If the
# caller speaks another of the three, she switches to it.
VOICE_LANGUAGE=en

# Speech to text: deepgram, elevenlabs or voicelab.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# A turn ends once Deepgram is this sure the caller has finished (0.5 to 1).
STT_CONFIDENCE=0.85
# Transcripts below this are treated as garbled.
UNCLEAR_BELOW=0.5

# Text to speech: elevenlabs or voicelab.
TTS_PROVIDER=elevenlabs

# Text to speech, and speech to text if STT_PROVIDER is elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# VoiceLab. Speaks and understands Uzbek, Russian and English. The key (vlk_...) is
# made in your account at voicelab.uz/app; it needs the tts:realtime and stt:realtime
# permissions.
VOICELAB_API_KEY=
# Gulnoza, who speaks all three. Others are listed by GET https://api.voicelab.uz/v1/voices
VOICELAB_VOICE=voice_01J9NEUTRAL0000000000000001
# 0.5 to 2.
VOICELAB_SPEED=1.0
# How long the caller is quiet before what they said is sent to be written down.
# Shorter answers sooner but may cut a slow speaker off mid-thought.
VOICELAB_PAUSE_MS=600

# --- A phone over Bluetooth (voice/bluetooth.py), instead of Twilio ---

# Blank picks the first phone in oFono and the first Bluetooth microphone and
# speaker in PulseAudio or PipeWire. `pactl list short sources` shows the names.
BLUETOOTH_MODEM=
BLUETOOTH_SOURCE=
BLUETOOTH_SINK=

# How long the caller can be quiet before Aida checks on them.
SILENCE_SECONDS=8
